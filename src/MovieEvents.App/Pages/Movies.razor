@page "/movies"

<PageTitle>Movies - MovieEvents</PageTitle>

<h1><i class="bi bi-camera-reels"></i> Movies</h1>

<div class="row mt-3">
    <div class="col-md-8">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Search movies..."
                   @bind="_searchQuery" @bind:event="oninput"
                   @onkeydown="HandleKeyDown" />
            <button class="btn btn-primary" @onclick="SearchMovies" disabled="@_isSearching">
                @if (_isSearching)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <i class="bi bi-search"></i>
                }
                Search
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @_errorMessage
    </div>
}

@if (_searchResults is not null && _searchResults.Results.Count > 0)
{
    <h3 class="mt-4">Search Results</h3>
    <div class="row g-3 mt-1">
        @foreach (var movie in _searchResults.Results)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(movie.PosterPath))
                    {
                        <img src="@movie.GetPosterUrl("https://image.tmdb.org/t/p/", "w300")"
                             class="card-img-top" alt="@movie.Title" loading="lazy" />
                    }
                    <div class="card-body">
                        <h6 class="card-title">@movie.Title</h6>
                        <p class="card-text small text-muted">@movie.ReleaseDate</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-star-fill"></i> @movie.VoteAverage.ToString("F1")
                            </span>
                            @if (IsFavourite(movie))
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => RemoveFavourite(movie)">
                                    <i class="bi bi-heart-fill"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AddFavourite(movie)">
                                    <i class="bi bi-heart"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (_searchResults.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PreviousPage">Previous</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page @_currentPage of @_searchResults.TotalPages</span>
                </li>
                <li class="page-item @(_currentPage >= _searchResults.TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPage">Next</button>
                </li>
            </ul>
        </nav>
    }
}

<h3 class="mt-4"><i class="bi bi-heart-fill text-danger"></i> Favourites</h3>
@if (_state is not null && _state.Club.FavouriteMovies.Count > 0)
{
    <div class="row g-3 mt-1">
        @foreach (var movie in _state.Club.FavouriteMovies)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(movie.PosterPath))
                    {
                        <img src="@movie.GetPosterUrl("https://image.tmdb.org/t/p/", "w300")"
                             class="card-img-top" alt="@movie.Title" loading="lazy" />
                    }
                    <div class="card-body">
                        <h6 class="card-title">@movie.Title</h6>
                        <p class="card-text small text-muted">@movie.ReleaseDate</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-star-fill"></i> @movie.VoteAverage.ToString("F1")
                            </span>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveFavourite(movie)">
                                <i class="bi bi-heart-fill"></i> Remove
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted mt-2">No favourite movies yet. Search and add some!</p>
}

@code {
    [Inject] private IAppStateService AppStateService { get; set; } = default!;
    [Inject] private ITmdbApiClient TmdbApiClient { get; set; } = default!;

    private AppState? _state;
    private string _searchQuery = "";
    private TmdbSearchResult? _searchResults;
    private bool _isSearching;
    private string? _errorMessage;
    private int _currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        _state = await AppStateService.GetStateAsync(CancellationToken.None);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchMovies();
        }
    }

    private async Task SearchMovies()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;

        _isSearching = true;
        _errorMessage = null;

        var result = await TmdbApiClient.SearchMoviesAsync(_searchQuery, _currentPage, CancellationToken.None);
        if (result.IsSuccess)
        {
            _searchResults = result.Value;
        }
        else
        {
            _errorMessage = result.Error;
        }

        _isSearching = false;
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await SearchMovies();
        }
    }

    private async Task NextPage()
    {
        if (_searchResults is not null && _currentPage < _searchResults.TotalPages)
        {
            _currentPage++;
            await SearchMovies();
        }
    }

    private bool IsFavourite(Movie movie)
    {
        return _state?.Club.FavouriteMovies.Any(m => m.Id == movie.Id) ?? false;
    }

    private async Task AddFavourite(Movie movie)
    {
        if (_state is null) return;
        _state.Club.AddFavourite(movie);
        await AppStateService.SaveStateAsync(_state, CancellationToken.None);
    }

    private async Task RemoveFavourite(Movie movie)
    {
        if (_state is null) return;
        _state.Club.RemoveFavourite(movie.Id);
        await AppStateService.SaveStateAsync(_state, CancellationToken.None);
    }
}
