@page "/"

<PageTitle>Dashboard - MovieEvents</PageTitle>

<h1><i class="bi bi-speedometer2"></i> Dashboard</h1>

@if (_state is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="row g-4 mt-2">
        <div class="col-md-4 col-sm-6">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="bi bi-camera-reels fs-1 text-primary"></i>
                    <h5 class="card-title mt-2">Favourite Movies</h5>
                    <p class="display-6">@_state.Club.FavouriteMovies.Count</p>
                    <a href="movies" class="btn btn-outline-primary btn-sm">Browse Movies</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="bi bi-people fs-1 text-success"></i>
                    <h5 class="card-title mt-2">Friends</h5>
                    <p class="display-6">@_state.Club.Friends.Count</p>
                    <a href="friends" class="btn btn-outline-success btn-sm">Manage Friends</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="bi bi-calendar-event fs-1 text-warning"></i>
                    <h5 class="card-title mt-2">Upcoming Events</h5>
                    <p class="display-6">@_upcomingCount</p>
                    <a href="events" class="btn btn-outline-warning btn-sm">View Events</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="bi bi-person-lines-fill fs-1 text-info"></i>
                    <h5 class="card-title mt-2">Groups</h5>
                    <p class="display-6">@_state.Club.Groups.Count</p>
                    <a href="groups" class="btn btn-outline-info btn-sm">Manage Groups</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="bi bi-geo-alt fs-1 text-danger"></i>
                    <h5 class="card-title mt-2">Locations</h5>
                    <p class="display-6">@_state.Club.Locations.Count</p>
                    <a href="locations" class="btn btn-outline-danger btn-sm">Manage Locations</a>
                </div>
            </div>
        </div>
    </div>

    @if (_upcomingEvents.Count > 0)
    {
        <h3 class="mt-4"><i class="bi bi-calendar-check"></i> Upcoming Events</h3>
        <div class="list-group mt-2">
            @foreach (var evt in _upcomingEvents)
            {
                <div class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@evt.Movie.Title</h5>
                        <small>@evt.EventDate.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>
                    <p class="mb-1">
                        <i class="bi bi-geo-alt"></i> @evt.Location.Name
                        @if (!string.IsNullOrEmpty(evt.Notes))
                        {
                            <br /><small class="text-muted">@evt.Notes</small>
                        }
                    </p>
                </div>
            }
        </div>
    }
}

@code {
    [Inject] private IAppStateService AppStateService { get; set; } = default!;

    private AppState? _state;
    private List<MovieEvent> _upcomingEvents = [];
    private int _upcomingCount;

    protected override async Task OnInitializedAsync()
    {
        _state = await AppStateService.GetStateAsync(CancellationToken.None);
        _upcomingEvents = _state.Club.Events
            .Where(e => e.Status == EventStatus.Scheduled && e.EventDate > DateTimeOffset.UtcNow)
            .OrderBy(e => e.EventDate)
            .Take(5)
            .ToList();
        _upcomingCount = _state.Club.Events
            .Count(e => e.Status == EventStatus.Scheduled && e.EventDate > DateTimeOffset.UtcNow);
    }
}
